# ===========================================
# Movie Streaming Platform — Environment
# ===========================================

# Application
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/movie-streaming

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Admin Setup (used by setup:admin script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Storage (local for dev, s3 for production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./public/uploads

# AWS S3 (production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Upload Limits
MAX_VIDEO_SIZE_MB=500
MAX_POSTER_SIZE_MB=10
